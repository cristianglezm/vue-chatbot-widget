{
  "name": "vue-chatbot-widget-demo",
  "version": "0.0.9",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Demo website for the vue-chatbot-widget",
  "author": "Cristian Gonzalez <cristian.glez.m@gmail.com>",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/@cristianglezm/vue-chatbot-widget"
  ],
  "scripts": {
    "dev": "vite",
    "dev:widget": "npm run watch -w @cristianglezm/vue-chatbot-widget",
    "build:widget": "npm run build -w @cristianglezm/vue-chatbot-widget",
    "build": "npm run build:widget && npm run type-check && vite build",
    "buildGH": "npm run build:widget && npm run type-check && vite build --base=/vue-chatbot-widget/",
    "type-check": "vue-tsc --build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "lint:widget": "npm run lint -w @cristianglezm/vue-chatbot-widget",
    "test:widget": "npm run test -w @cristianglezm/vue-chatbot-widget",
    "format": "prettier --write src/",
    "clean": "rm -rf dist && npm run clean -w @cristianglezm/vue-chatbot-widget",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "show": "playwright show-report"
  },
  "dependencies": {
    "@cristianglezm/vue-chatbot-widget": "workspace:*",
    "mitt": "^3.0.1",
    "pinia": "^4.1.0",
    "prismjs": "^1.30.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.2.1",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.13"
  }
}
